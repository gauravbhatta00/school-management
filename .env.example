# ══════════════════════════════════════════════════════════════════════════════
# School Management System - Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Configuration ───────────────────────────────────────────────────────
# REQUIRED: Generate a strong 50+ character secret key
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-secret-key-change-this-in-production-min-50-chars

# Environment: 'dev' or 'prod' (controls debug mode, allowed hosts, HTTPS, etc.)
DJANGO_ENV=dev

# Debug mode: 'true' only in development, 'false' in production
DEBUG=false

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=YOUR_SERVER_IP,localhost,127.0.0.1,backend

# ── Database Configuration ────────────────────────────────────────────────────
# The system auto-detects SQLite vs PostgreSQL based on DATABASE_URL format:
# - If DATABASE_URL is empty: defaults to SQLite (db.sqlite3)
# - If DATABASE_URL starts with 'postgres://': uses PostgreSQL

# For Docker Compose: Always use PostgreSQL with docker-compose (set above DB_* vars)
# For Local Development: Leave empty to use SQLite, or set DATABASE_URL for Postgres
DATABASE_URL=

# PostgreSQL Configuration (used by docker-compose and optional local Postgres setups)
DB_ENGINE=postgresql      # Changed from sqlite3 for docker-compose
DB_NAME=school_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db                 # Use 'db' for docker-compose, 'localhost' for local Postgres
DB_PORT=5432

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces)
# For Docker: frontend service is on port 80, backend on 8000
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:3000,http://localhost:8000

# CSRF trusted origins (needed for admin/login POSTs in production)
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_SERVER_IP

# ── Frontend Configuration ────────────────────────────────────────────────────
# Backend API URL that the frontend will use
# Leave empty when frontend and backend are served from the same host (nginx reverse proxy)
VITE_API_URL=

# ── Production Settings (Required for DJANGO_ENV=prod) ─────────────────────────
# Comma-separated domain names
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
#
# SSL/HTTPS (uncomment for production)
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# HSTS settings
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
#
# PostgreSQL SSL (if using managed databases)
# DB_SSL_MODE=require

# ── Optional: Redis Cache (for future use) ──────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
