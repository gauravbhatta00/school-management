# Example environment variables for local development and CI
# Copy to `.env` and fill values for local development. DO NOT commit `.env`.

# Django secret key
SECRET_KEY=change-me-in-production

# PostgreSQL Configuration
# Leave DATABASE_URL empty to use the DB_* values below.
DATABASE_URL=
DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS allowed origins (comma separated)
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1

# Public frontend URL used in password reset emails
FRONTEND_URL=http://localhost:5173
SITE_NAME=EduCore

# Email delivery for password reset in production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=EduCore <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Allowed hosts and CSRF trusted origins for production
ALLOWED_HOSTS=YOUR_SERVER_IP,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_SERVER_IP
