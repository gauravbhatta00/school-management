# Copy to .env.electron for local Electron-mode development
# (npm run dev:frontend:electron / npm run dev:desktop from the repo root).
# Not secret — the desktop backend (Waitress, started by Electron) always
# listens on this fixed loopback address.
#
# Electron-mode is a hybrid: React is still served by the Vite dev server
# (like normal browser dev), but it talks to the Stage 1 desktop backend
# on 8765 instead of the Django dev server on 8000.

VITE_API_URL=http://127.0.0.1:8765
VITE_PORT=5173
