# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_ENV=prod
DEBUG=false

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=YOUR_SERVER_IP,localhost,127.0.0.1,backend,qubinery.space,www.qubinery.space

# ── Database Configuration ────────────────────────────────────────────────────
# PostgreSQL Configuration (used by docker-compose / prod). Local dev and the
# desktop build use SQLite by default instead — see SQLITE_NAME below.
# Use docker-compose defaults for local development, or point these at a managed database.
DATABASE_URL=

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces)
# For Docker: frontend service is on port 80, backend on 8000
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:3000,http://localhost:8000,https://qubinery.space,https://www.qubinery.space

# CSRF trusted origins (needed for admin/login POSTs in production)
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_SERVER_IP,https://qubinery.space,https://www.qubinery.space

# ── Frontend Configuration ────────────────────────────────────────────────────
# Backend API URL that the frontend will use
# Leave empty when frontend and backend are served from the same host (nginx reverse proxy)
VITE_API_URL=

# Public frontend URL used in password reset emails
FRONTEND_URL=http://localhost:5173
SITE_NAME=EduCore

# Local development and the desktop build use SQLite by default.
SQLITE_NAME=db.sqlite3

# Production PostgreSQL RDS
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=change-this-database-password
DB_SSL_MODE=require

# Production S3 storage for static and media files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_STATIC_LOCATION=static
AWS_MEDIA_LOCATION=media
AWS_QUERYSTRING_AUTH=false

# Frontend build
# Leave empty when frontend and backend are served from the same domain.
FRONTEND_API_URL=

# HTTPS security.
# Keep false/0 for direct HTTP. Enable these when HTTPS is working.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=EduCore <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
