# Copy to .env (or .env.development / .env.desktop) for local use.
# None of these values are secret — they only configure which backend
# origin the frontend talks to.

# Origin of the Django backend. Endpoint paths already include their own
# "/api/..." prefix (see src/services/api.js), so this must NOT end in /api.
VITE_API_URL=http://127.0.0.1:8000

# Vite dev-server proxy target for /api requests (browser dev only).
VITE_API_TARGET=http://127.0.0.1:8000

# Vite dev-server port.
VITE_PORT=5173
