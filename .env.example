SECRET_KEY=your-very-secret-key-change-this-in-production-min-50-chars
DJANGO_ENV=dev

# Database Configuration (supports both SQLite and Postgres)
# Leave blank or omit for SQLite (default: db.sqlite3)
# For SQLite: DATABASE_URL=sqlite:///./db.sqlite3
# For Postgres: DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/school_db
DATABASE_URL=

# Local development defaults to SQLite if DATABASE_URL is empty.
# Set DB_ENGINE=postgresql only if you want to use a local PostgreSQL server.
DB_ENGINE=sqlite3

# PostgreSQL settings used by docker-compose and optional local Postgres setups.
DB_NAME=school_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# Production only
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DB_SSL_MODE=require
