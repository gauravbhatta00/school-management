# Optional local overrides for Electron development (Stage 2).
# Copy to desktop/.env for machine-specific values; desktop/.env is
# gitignored and never committed. None of these are required — sensible
# defaults are auto-discovered from the repo layout.

# Origin Electron loads React from during development. Must match the Vite
# dev server actually running (see frontend/.env.electron's VITE_PORT).
ELECTRON_DEV_SERVER_URL=http://127.0.0.1:5173

# Absolute path to the Python interpreter used to run the backend.
# Defaults to backend/.venv/Scripts/python.exe (Windows) if not set.
# DESKTOP_PYTHON_PATH=C:\path\to\your\venv\Scripts\python.exe

# Path to the desktop backend launcher script, relative to the repo root
# (or absolute). Defaults to backend/desktop_launcher.py.
# DESKTOP_BACKEND_LAUNCHER=backend/desktop_launcher.py

# Set to 1 to auto-open DevTools when running `npm run dev:electron`.
# Development only — ignored in packaged builds.
# ELECTRON_OPEN_DEVTOOLS=1

# Which backend Electron starts (Stage 3). Unset or "source" runs the
# Stage 1 Python launcher (backend/desktop_launcher.py) — the default, best
# for Django development since code changes take effect without a rebuild.
# "packaged" runs the Stage 3 PyInstaller executable instead (build it
# first with `npm run build:backend`), useful for testing the future
# distributed architecture. Any other value fails loudly at startup rather
# than silently picking one.
# DESKTOP_BACKEND_MODE=source

# Absolute or repo-root-relative path to the packaged backend executable.
# Only used when DESKTOP_BACKEND_MODE=packaged.
# Defaults to backend/dist/school-backend/school-backend.exe.
# DESKTOP_BACKEND_EXE=backend/dist/school-backend/school-backend.exe
